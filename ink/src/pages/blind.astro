---
import Layout from '../layouts/Layout.astro';
import MinigameBlind from '../components/Minigames/Blind/Minigame-Blind.astro';
---

<Layout backUrl="/blind-introduction" hideBackButton={false}>
    <div id="minigame-blind" transition:name="blind-window">
