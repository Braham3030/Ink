---
import Layout from "../layouts/Layout.astro"
import DisabilityIntroduction from "../components/Disability-Introduction.astro"
import speechDisability from "../assets/images/disabilities/speech.jpg"
---

<Layout>
    <div transition:name="speech-introduction-window">
        <DisabilityIntroduction 
        name="Evelin"
        image={speechDisability}
        description="Evelin is een burger die een afspraak heeft voor het verlengen van haar paspoort. Jij helpt haar hierbij. Evelin heeft een spraakgebrek en neemt de tijd om haar zinnen af te maken, waarbij haar manier van spreken vraagt om geduld en aandacht in het gesprek."
        link="/speech"
        animation="speech-window"
        />
    </div>
</Layout>

<style>
  body {
    --detail-bg-normal: #ffbda6;
    --detail-bg-dark: #ff936e;
    --detail-bg-light: #ffffff;
  }
</style>
