---
import Layout from "../layouts/Layout.astro"
import DisabilityIntroduction from "../components/Disability-Introduction.astro"
import speechDisability from "../assets/images/disabilities/speech.jpg"
import Popup from "../components/Popup.astro";
---

<Layout backUrl="/choice" hideBackButton={false}>
    <div transition:name="speech-introduction-window">
        <DisabilityIntroduction 
        name="Evelin"
        image={speechDisability}
        description="Evelin heeft een afspraak voor het verlengen van haar paspoort. U helpt haar hierbij. Evelin heeft een spraakgebrek en neemt de tijd om haar zinnen af te maken, waarbij haar manier van spreken vraagt om geduld en aandacht in het gesprek."
        link="/speech"
        animation="speech-window"
        />
    </div>
</Layout>

<Popup />

<style>
  body {
    --detail-bg-normal: #ffbda6;
    --detail-bg-dark: #ff936e;
    --detail-bg-light: #ffffff;
  }
</style>

<script>
  // @ts-nocheck

  window.helpContext = {
    title: "Ongemakkelijk voelen",
    text: "Als u zich ongemakkelijk voelt, probeer dit dan niet te laten blijken. Blijf neutraal en houd natuurlijk oogcontact."
  }
