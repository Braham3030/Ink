---
import Layout from "../layouts/Layout.astro";
import DisabilityIntroduction from "../components/Disability-Introduction.astro";
---

<Layout>
  <div transition:name="deaf-introduction-window">
    <DisabilityIntroduction
      name="Eva"
      image="/images/disabilities/auditory.jpg"
      description="Eva is volledig doof en gebruikt een taal. Jij en Nick zitten samen in een café. Eva vraagt aan jou of je hem naar de WC zou kunnen wijzen. Aan jou de opdracht: hoe zou je dit aanpakken?"
      link="/deaf"
      animation="deaf-window"
    />
  </div>
</Layout>

<style>
  body {
    --detail-bg-light: #ffffff;
  }
</style>
