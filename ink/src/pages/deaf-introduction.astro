---
import Layout from "../layouts/Layout.astro";
import DisabilityIntroduction from "../components/Disability-Introduction.astro";
import auditoryDisability from "../assets/images/disabilities/auditory.jpg";
---

<Layout>
  <div transition:name="deaf-introduction-window">
    <DisabilityIntroduction
      name="Eva"
      image={auditoryDisability}
      description="Eva is volledig doof en communiceert via gebarentaal. Jij en Eva bevinden je samen in een openbare ruimte. Eva vindt het fijn wanneer mensen zich verstaanbaar kunnen maken met handgebaren en visuele aanwijzingen, zodat ze makkelijk kan begrijpen wat er bedoeld wordt en zich goed kan oriënteren."
      link="/deaf"
      animationNext="deaf-introduction-window"
    />
  </div>
</Layout>

<style>
  body {
    --detail-bg-light: #ffffff;
  }
</style>
