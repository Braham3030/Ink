---
import Layout from "../layouts/Layout.astro"
import DisabilityIntroduction from "../components/Disability-Introduction.astro"
import MotorialDisability from "../assets/images/disabilities/motor.jpg"
import Popup from "../components/Popup.astro";
---

<Layout backUrl="/choice" hideBackButton={false}>
    <div transition:name="motorial-introduction-window">
        <DisabilityIntroduction 
        name="Anna"
        image={MotorialDisability}
        description="Anna heeft een motorische beperking en gebruikt een rolstoel. U en Anna bevinden zich samen in een openbare ruimte. Anna vraagt u om haar te helpen haar weg te vervolgen. Het is aan u om mogelijke obstakels te herkennen en aan te geven, zodat ze veilig en zelfstandig verder kan."
        link="/motorial"
        animation="motorial-window"
        />
    </div>
</Layout>

<Popup />

<style>
  body {
    --detail-bg-normal: #c8d6ff;
    --detail-bg-dark: #7194ff;
    --detail-bg-light: #ffffff;
  }
</style>

<script>
  // @ts-nocheck

  window.helpContext = {
    title: "Benaming",
    text: "De benaming invalide kan kwetsend zijn. Zeg in plaats daarvan: 'persoon met een rolstoel, persoon met een motorische beperking'."
  }