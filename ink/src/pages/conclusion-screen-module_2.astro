---
// @ts-nocheck
import Layout from "../layouts/Layout.astro"
import Conclusion from "../components/Conclusion-screen.astro"
import Popup from "../components/Popup.astro";

---

<!-- const { moduleName, conclusion, moduleType, animation, linkModule } = Astro.props; -->


<Layout hideBackButton={true}>
    <Conclusion transition:name="deaf-introduction-window"
    moduleName="Module 2"
      conclusion="De maatschappij is er niet echt op ingericht. Dus laat ik bijvoorbeeld over straat lopen. Ja, er zijn nergens geleidlijnen, veel stoplichten tikken niet. Als het rood of groen is, weet je ook niet wanneer je can oversteken."
      moduleType="Module 2"
      linkModule="/modules"
      animationButton="button-modules"
      animationText="module-title-2"
      />
</Layout>

<Popup />

<script>
  // @ts-nocheck

  window.helpContext = {
    title: "Blindegeleidehonden",
    text: "Blindegeleidehonden en hulphonden zijn heel lief, maar mogen helaas niet geaaid worden als ze aan het werk zijn."
  }
</script>