---
// @ts-nocheck
import Layout from "../layouts/Layout.astro"
import Conclusion from "../components/Conclusion-screen.astro"
import Popup from "../components/Popup.astro";

---

<!-- const { moduleName, conclusion, moduleType, animation, linkModule } = Astro.props; -->


<Layout hideBackButton={true}>
    <Conclusion transition:name="deaf-introduction-window"
    moduleName="leren door te ervaren"
      conclusion="Door de simulaties en de bijhorende contextuele informatie is er een dieper begrip ontstaan van de obstakels die deze mensen tegenkomen in het dagelijks leven. Het doel van de simulatie is niet enkel om de variatie te signaleren, maar ook het ontwikkelen van een empathische en respectvolle houding met betrekking tot de variaties."
      linkModule="/modules"
      animationButton="button-modules"
      animationText="module-title-2"
      />
</Layout>

<Popup />

<script>
  // @ts-nocheck

  window.helpContext = {
    title: "Spreek direct aan",
    text: "Spreek direct tegen de persoon aan wie u service verleend en niet over hen tegen hun gezelschap. Het zijn autonome mensen zoals ieder ander. U kunt ze direct aanspreken als elke andere klant."
  }
</script>