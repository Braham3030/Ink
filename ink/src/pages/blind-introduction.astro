---
import Layout from "../layouts/Layout.astro"
import DisabilityIntroduction from "../components/Disability-Introduction.astro"
import visualDisability from "../assets/images/disabilities/visual.jpg"
import Popup from "../components/Popup.astro";
---

<Layout backUrl="/choice" hideBackButton={false}>
    <div transition:name="blind-introduction-window">
        <DisabilityIntroduction 
        name="Tim"
        image={visualDisability}
        description="Tim is volledig blind en loopt met een stok. Jij en Tim bevinden je samen in een openbare ruimte. Tim vraagt je hem te helpen zijn weg te vinden naar verschillende bestemmingen. Jij geeft stap voor stap duidelijke en betrouwbare aanwijzingen zodat hij zich veilig kan verplaatsen en zijn doelen kan bereiken."
        link="/blind"
        animation="blind-window"
        />
    </div>
</Layout>

<Popup />

<style>
  body {
    --detail-bg-normal: #f9ffad;
    --detail-bg-dark: #e7f079;
    --detail-bg-light: #ffffff;
  }
</style>

<script>
  // @ts-nocheck

  window.helpContext = {
    title: "Stel jezelf voor",
    text: "Mensen met een visuele beperking kunnen niet zien wanneer je voor ze staat. Stel jezelf daarom altijd voor door middel van je naam en je functie. Want een uniform is ook niet zichtbaar.",
  };
</script>