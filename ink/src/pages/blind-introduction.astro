---
import Layout from "../layouts/Layout.astro"
import DisabilityIntroduction from "../components/Disability-introduction.astro"
---

<Layout>
    <div transition:name="blind-introduction-window">
        <DisabilityIntroduction 
        name="Tim"
        image="/images/disabilities/visual.jpg"
        description="Tim is volledig blind en loopt met een stok. Jij en Tim zitten samen in een café. Tim vraagt aan jou of je hem naar de WC zou kunnen wijzen. Aan jou de opdracht: hoe zou je dit aanpakken?"
        link="/blind"
        animation="blind-window"
        />
    </div>
</Layout>