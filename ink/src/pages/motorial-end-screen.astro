---
// @ts-nocheck
import Layout from "../layouts/Layout.astro";
import EndScreen from "../components/End-Screen.astro";
import Popup from "../components/Popup.astro";
---

<Layout hideBackButton={true}>
  <EndScreen
    name="motorisch beperkt"
    quote="Je gaat liever naar plekken waarvan je weet dat het goed toegankelijk is. Een nieuwe plek probeer je liever uit met vriendinnen, niet alleen."
    quoteBy="Iemand met een motorische beperking"
    linkChoice="/choice"
    linkNext="/visual-introduction"
    animation="visual-introduction-window"
    animationNext="choice1-window"
    disabilityName="Opvallend uiterlijk"
    pageType="de keuze pagina"
  />
</Layout>

<Popup />

<script>
  // @ts-nocheck

  window.helpContext = {
    title: "Gebruik gebruikelijke woorden",
    text: "U kunt gebruikelijke woorden wel gebruiken zoals 'lopen'. U hoeft niet 'rollen' te zeggen in plaats van 'lopen'.",
  };
</script>
