---
// @ts-nocheck
import Layout from "../layouts/Layout.astro"
import EndScreen from "../components/End-Screen.astro"
import Popup from "../components/Popup.astro";
---

<Layout hideBackButton={true}>
    <EndScreen 
    name="motorisch beperkt"
      quote="Je gaat sneller naar plekken waarvan je weet dat het goed zit in plaats van een nieuwe plek en als je een nieuwe plek uitprobeert liever met vriendinnen en niet alleen."
      quoteBy="Marleen, motorisch beperkt"
      linkChoice="/choice"
      linkNext="/visual-introduction"
      animation="visual-introduction-window"
      animationNext="choice1-window"
      disabilityName="Opvallend uiterlijk"
      pageType="de keuze pagina"
      />
</Layout>

<Popup />

<script>
  // @ts-nocheck

  window.helpContext = {
    title: "Gebruik gebruikelijke woorden",
    text: "U kunt gebruikelijke woorden wel gebruiken zoals 'lopen'. Je hoeft niet 'rollen' te zeggen in plaats van 'lopen'."
  }