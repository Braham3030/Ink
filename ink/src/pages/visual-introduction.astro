---
import Layout from "../layouts/Layout.astro"
import DisabilityIntroduction from "../components/Disability-Introduction.astro"
import looksDisability from "../assets/images/disabilities/looks.jpg"
import Popup from "../components/Popup.astro";
---

<Layout backUrl="/choice" hideBackButton={false}>
    <div transition:name="visual-introduction-window">
        <DisabilityIntroduction 
        name="Eduard"
        image={looksDisability}
        description="Eduard is je nieuwe collega op de werkplek. Hij heeft een opvallend uiterlijk door zichtbare huidkenmerken in zijn gezicht en wil graag op dezelfde manier behandeld worden als ieder ander. Samen werken jullie in een omgeving waar samenwerking en gelijkwaardigheid centraal staat."
        link="/visual"
        animation="speech-window"
        />
    </div>
</Layout>

<Popup />

<style>
  body {
    --detail-bg-normal: #ff93df;
    --detail-bg-dark: #ffd1f1;
    --detail-bg-light: #ffffff;
  }
</style>

<script>
  // @ts-nocheck

  window.helpContext = {
    title: "Niet verboden te vragen",
    text: "Het is niet verboden om iets te vragen over iemands uiterlijk. Maar zorg ervoor dat de persoon centraal staat en niet het uiterlijk."
  }