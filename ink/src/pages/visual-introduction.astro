---
import Layout from "../layouts/Layout.astro"
import DisabilityIntroduction from "../components/Disability-Introduction.astro"
import looksDisability from "../assets/images/disabilities/looks.jpeg"
---

<Layout>
    <div transition:name="visual-introduction-window">
        <DisabilityIntroduction 
        name="Eduard"
        image={looksDisability}
        description="Eduard is volledig blind en loopt met een stok. Jij en Eduard zitten samen in een café. Eduard vraagt aan jou of je hem naar de WC zou kunnen wijzen. Aan jou de opdracht: hoe zou je dit aanpakken?"
        link="/visual"
        animation="speech-window"
        />
    </div>
</Layout>