<style>
	html,
	body {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
		background: conic-gradient(
    from 330deg at 50% 50%,
    var(--detail-bg-light) 0deg 115deg,       /* Wit (boven/rechts) */
    var(--detail-bg-dark) 115deg 220deg,     /* Donkergroen (onder/rechts) */
    var(--detail-bg-normal) 220deg 360deg      /* Lichtgroen (links) */
  );

	}

	main {
		margin-top: 6rem;
	}
</style>
