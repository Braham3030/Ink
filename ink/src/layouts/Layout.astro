---
import Home from '../components/Home.astro';
import Header from '../components/Header.astro';
import MinigameBlind from '../components/Minigame-Blind.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Ink</title>
	</head>
	<body>
		<Header />
		<main>
			<div id="home">
				<Home />
			</div>
			<div id="minigame-blind" class="hidden">
				<MinigameBlind />
			</div>
		</main>
		<slot />
	</body>
</html>

<script>
	// Javascript dynamically changes the components on the page.
	const startButton = document.querySelector('.startButton');

	const home = document.getElementById('home');
	const miniGameBlind = document.getElementById('minigame-blind');

	if (startButton && home && miniGameBlind) {
	startButton.addEventListener('click', () => {
		home.style.display = 'none';
		miniGameBlind.style.display = 'block';

		miniGameBlind.classList.remove('hidden');
	});
}
</script>



<style>
	html,
	body {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;

		> main {
			/* background-color: green; */
			height: 100%;
			width: 100%;
		}
	}

	.hidden {
		display: none;
	}
</style>
