---
import Header from "../components/Header.astro";
// View-transitions for animations between pages, and less load time.
// https://docs.astro.build/en/guides/view-transitions/
import { ClientRouter } from "astro:transitions";

import HelpButton from "../components/HelpButton.astro";

const {backUrl = "/", hideBackButton = false} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/Logo.svg" />
    <link rel="icon" href="/Logo.svg" />
    <link rel="stylesheet" href="/styles/style.css" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>Ink</title>
  </head>
  <body>
    <Header backUrl={backUrl} hideBackButton={hideBackButton} />
    <main>
      <slot />
    </main>
    <HelpButton />
    <!-- Service worker for PWA -->
    <!-- https://developer.mozilla.org/en-US/docs/Web/Progressive_web_apps/Tutorials/js13kGames/Offline_Service_workers -->
    <script>
    // @ts-nocheck
    // Script for offline usage, PWA

    if ("serviceWorker" in navigator) {
      window.addEventListener("load", function () {
        navigator.serviceWorker.register("/sw.js")
          .then(function (registration) {
            console.log("ServiceWorker registration successful with scope: ", registration.scope);
          })
          .catch(function (error) {
            console.log("ServiceWorker registration failed: ", error);
          })
      })
    }
  </script>
  </body>
</html>



<style>
  body {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    width: 100vw;
    min-height: 100vh;
    background: conic-gradient(
      from 330deg at 50% 50%,
      var(--detail-bg-light) 0deg 115deg,
      var(--detail-bg-dark) 115deg 220deg,
      var(--detail-bg-normal) 220deg 360deg
    );
    background-attachment: fixed;
    background-repeat: no-repeat;
    padding-bottom: 1rem;
  }
</style>
