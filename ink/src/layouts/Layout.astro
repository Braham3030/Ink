---
import Header from "../components/Header.astro";
// View-transitions for animations between pages, and less load time.
// https://docs.astro.build/en/guides/view-transitions/
import { ClientRouter } from "astro:transitions";
import { getImage } from "astro:assets";

import visualDisability from "../assets/images/disabilities/visual.jpg";
import auditoryDisability from "../assets/images/disabilities/auditory.jpg";
import motorialDisability from "../assets/images/disabilities/motor.jpg";
import looksDisability from "../assets/images/disabilities/looks.jpg";
import speechDisability from "../assets/images/disabilities/speech.jpg";

// Preload image.
const preloadVisual = await getImage({ src: visualDisability });
const preloadAuditory = await getImage({ src: auditoryDisability });
const preloadMotorial = await getImage({ src: motorialDisability });
const preloadLooks = await getImage({ src: looksDisability });
const preloadSpeech = await getImage({ src: speechDisability });

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/Logo.svg" />
    <link rel="icon" href="/Logo.svg" />
    <link rel="stylesheet" href="/styles/style.css" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <link
      rel="preload"
      as="image"
      href={preloadVisual.src}
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={preloadAuditory.src}
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={preloadMotorial.src}
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={preloadLooks.src}
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={preloadSpeech.src}
      fetchpriority="high"
    />
    <title>Ink</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <svg
      width="118"
      height="121"
      viewBox="0 0 118 121"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
    >
      <rect
        y="33.2617"
        width="123"
        height="110"
        transform="rotate(-15.6893 0 33.2617)"
        fill="url(#pattern0_123_272)"></rect>
      <defs>
        <pattern
          id="pattern0_123_272"
          patternContentUnits="objectBoundingBox"
          width="1"
          height="1"
        >
          <use
            xlink:href="#image0_123_272"
            transform="scale(0.00249377 0.00277778)"></use>
        </pattern>
        <image
          id="image0_123_272"
          width="1920"
          height="360"
          preserveAspectRatio="none"
          xlink:href="data:image/png;base64,"
        />
      </defs>
    </svg>
  </body>
</html>

