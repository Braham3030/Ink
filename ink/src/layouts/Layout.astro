<style>
  body {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    width: 100vw;
    min-height: 100vh;
    background: conic-gradient(
      from 330deg at 50% 50%,
      var(--detail-bg-light) 0deg 115deg,
      var(--detail-bg-dark) 115deg 220deg,
      var(--detail-bg-normal) 220deg 360deg
    );
    background-attachment: fixed;
    background-repeat: no-repeat;
    padding-bottom: 1rem;
  }

  main {
    padding-top: 4rem;
  }
</style>
