---
import Home from '../components/Home.astro';
import Header from '../components/Header.astro';
import MinigameBlind from '../components/Minigame-Blind.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="stylesheet" href="/styles/style.css" />
		<meta name="generator" content={Astro.generator} />
		<title>Ink</title>
	</head>
	<body>
		<Header />
		<main>
			<div id="home">
				<Home />
			</div>
			<div id="minigame-blind" class="hidden">
				<MinigameBlind />
			</div>
		</main>
		<slot />
	</body>
</html>

<script>
	// Javascript dynamically changes the components on the page.
	const startButton = document.querySelector('.startButton');

	const home = document.getElementById('home');
	const miniGameBlind = document.getElementById('minigame-blind');

	if (startButton && home && miniGameBlind) {
	startButton.addEventListener('click', () => {
		// home.style.opacity = '0';
		// home.style.width = '0%';

		home.classList.add('hidden');
		// miniGameBlind.style.opacity = '1';
		// miniGameBlind.style.width = '100%';

		miniGameBlind.classList.remove('hidden');
	});
}
</script>



<style>
	html,
	body {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;

		> main {
			/* background-color: green; */
			display: grid;
			margin-top: 10em;
			height: 100%;
			width: 100%;
			grid-template-columns: 1fr;
			grid-template-rows: 1fr;
		}
	}

	#home, #minigame-blind {
		grid-area: 1 / 1;
		opacity: 1;
		width: 100%;
		height: 100%;
		visibility: visible;
		pointer-events: auto;

		transition: opacity 0.6s cubic-bezier(0.33, 0.72, 0, 1.18), width 0.4s cubic-bezier(0.33, 0.72, 0, 1.18);
	}

	.hidden {
		opacity: 0 !important;
		width: 0%;
		visibility: hidden !important;
		pointer-events: none !important;

		transition: opacity 0.6s cubic-bezier(0.33, 0.72, 0, 1.18), width 0.5s cubic-bezier(0.33, 0.72, 0, 1.18), visibility 0.6s cubic-bezier(0.33, 0.72, 0, 1.18) 0.5s;
	}
</style>
