---
import Header from "../components/Header.astro";
// View-transitions for animations between pages, and less load time.
// https://docs.astro.build/en/guides/view-transitions/
import { ClientRouter } from "astro:transitions";
import { getImage } from "astro:assets";

import visualDisability from "../assets/images/disabilities/visual.jpg";
import auditoryDisability from "../assets/images/disabilities/auditory.jpg";
import motorialDisability from "../assets/images/disabilities/motor.jpg";
import looksDisability from "../assets/images/disabilities/looks.jpg";
import speechDisability from "../assets/images/disabilities/speech.jpg";

// Preload image.
const preloadVisual = await getImage({ src: visualDisability });
const preloadAuditory = await getImage({ src: auditoryDisability });
const preloadMotorial = await getImage({ src: motorialDisability });
const preloadLooks = await getImage({ src: looksDisability });
const preloadSpeech = await getImage({ src: speechDisability });

import HelpButton from "../components/HelpButton.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/Logo.svg" />
    <link rel="icon" href="/Logo.svg" />
    <link rel="stylesheet" href="/styles/style.css" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <link
      rel="preload"
      as="image"
      href={preloadVisual.src}
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={preloadAuditory.src}
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={preloadMotorial.src}
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={preloadLooks.src}
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={preloadSpeech.src}
      fetchpriority="high"
    />
    <title>Ink</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <HelpButton />
  </body>
</html>

<style>
  body {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    width: 100vw;
    min-height: 100vh;
    background: conic-gradient(
      from 330deg at 50% 50%,
      var(--detail-bg-light) 0deg 115deg,
      var(--detail-bg-dark) 115deg 220deg,
      var(--detail-bg-normal) 220deg 360deg
    );
    background-attachment: fixed;
    background-repeat: no-repeat;
    padding-bottom: 1rem;
  }
</style>
