    <h2>Kies een onderdeel</h2>

    <div class="choice-grid">
      <a href="/blind-introduction" class="choice" transition:name="blind-introduction-window">
        <img src="images/disabilities/visual.jpg" alt="Visueel beperkt persoon" />
        <h2>Visuele beperking</h2>
      </a>

      <a href="/deaf-introduction" class="choice" transition:name="deaf-introduction-window">
        <img src="images/disabilities/auditory.jpg" alt="Auditief beperkt persoon" />
        <h2>Auditieve beperking</h2>
      </a>

      <a href="/motorial-introduction" class="choice" transition:name="motorial-introduction-window">
        <img src="images/disabilities/motor.jpg" alt="Motorisch beperkt persoon" />
        <h2>Motorische beperking</h2>
      </a>

      <a href="/visual-introduction" class="choice" transition:name="visual-introduction-window">
        <img src="images/disabilities/looks.jpeg" alt="Opvallend uiterlijk persoon" />
        <h2>Opvallend uiterlijk</h2>
      </a>

      <a href="/speech-introduction" class="choice" transition:name="speech-introduction-window">
        <img src="images/disabilities/speech.jpg" alt="Spraakgebrek persoon" />
        <h2>Spraakgebrek</h2>
      </a>
    </div>


    <script>
    // @ts-nocheck

    // Transition name will be given upon page load. This script will contain the current animation, so the animation to the next screen will occur more precise
    document.addEventListener('astro:page-load', () => {
        const blindChoice = document.querySelector('.choice');

        if (blindChoice) {
            blindChoice.style.viewTransitionName = 'none'

            blindChoice.addEventListener('click', () => {
                blindChoice.style.viewTransitionName = 'blind-window'
            })
        }
    })
</script>



  <style>
    h1 {
      text-align: center;
      margin-top: 2em;
    }

    h2 {
      text-align: center;
    }

    img {
      display: block;
      width: 75%;
      border: 3px solid;
      border-radius: 5px;
      transition: all 0.3s ease-in-out;

      &:hover {
        cursor: pointer;
        scale: 1.05;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
      }
    }

    .choice-grid {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      gap: 1em;
      max-width: 1200px;
      margin: 0 auto;

      @media (min-width: 380px) {
        grid-template-columns: repeat(2, 1fr);
      }

    @media (min-width: 1024px) {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .choice {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      color: black;

      &:nth-child(1) img {
        border-color: #e7f079;
      }
      &:nth-child(2) img {
        border-color: #2bb687;
      }
      &:nth-child(3) img {
        border-color: #7194ff;
      }
      &:nth-child(4) img {
        border-color: #ff93df;
      }
      &:nth-child(5) img {
        border-color: #ff6631;
      }
    }
  </style>