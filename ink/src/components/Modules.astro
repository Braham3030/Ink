---
import Popup from "../components/Popup.astro";
---

<div class="full-container">
  <h2 transition:name="title-text">Kies een module om te starten</h2>
  <div class="module-container">
    <div class="module-item">
      <h3>Module 1:</h3>
      <a href="" class="module-choice">Bewustwording en vooroordelen</a>
    </div>
    <div class="module-item" transition:name="button-modules">
      <h3 transition:name="module-title-2">Module 2:</h3>
      <a href="/choice" class="module-choice" data-astro-prefetch="viewport">
        Leren door te ervaren
      </a>
    </div>
    <div class="module-item">
      <h3>Module 3:</h3>
      <a href="" class="module-choice">Vertaling naar werkplek</a>
    </div>
  </div>
</div>

<Popup />


<script>
  // @ts-nocheck
  window.helpContext = {
    title: "Doe geen aannames",
    text: "Als je iets niet zeker weet, vraag het dan. 'Heb je hulp nodig bij het dragen van je drankjes?' of 'Zal ik je naar je tafel begeleiden, of loop je er liever zelf naartoe?'",
  };

  document.addEventListener("astro:page-load", () => {
    const btn2 = document.querySelector(
      ".module-item:nth-child(2) .module-choice",
    );

    if (btn2) {
      btn2.style.viewTransitionName = "none";

      btn2.addEventListener("click", () => {
        btn2.style.viewTransitionName = "choice2-window";
      });
    }
  });
</script>

<style>
  :global(main) {
    padding-top: 3rem;
  }

  .module-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin: 1rem;
    padding: 0.5rem;
  }

  .module-item {
    width: 90%;
    max-width: 400px;

    > h3 {
      text-align: left;
      margin-bottom: 0.5rem;
    }
  }

  .module-choice {
    display: block;
    text-decoration: none;
    color: white;
    background: #111827;
    padding: 1.3rem 1rem;
    border-radius: 5px;
    font-size: var(--button-font-size);
    text-align: center;
  }

  .module-item:nth-child(1) .module-choice,
  .module-item:nth-child(3) .module-choice {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
