<div class="full-container">
  <h2>Kies een module om te starten</h2>
  <div class="module-container">
    <div class="module-item">
      <h3>Module 1:</h3>
      <a href="/choice" class="module-choice" data-astro-prefetch="viewport">
        Bewustwording en vooroordelen
      </a>
    </div>
    <div class="module-item">
      <h3>Module 2:</h3>
      <a href="" class="module-choice">Leren door te ervaren</a>
    </div>
    <div class="module-item">
      <h3>Module 3:</h3>
      <a href="" class="module-choice">Vertaling naar werkplek</a>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  document.addEventListener("astro:page-load", () => {
    const btn1 = document.querySelector(".module-choice");

    if (btn1) {
      btn1.style.viewTransitionName = "none";

      btn1.addEventListener("click", () => {
        btn1.style.viewTransitionName = "choice1-window";
      });
    }
  });
</script>

<style>
  .full-container {
    margin: 0 auto;
    text-align: center;
  }

  .module-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin: 1rem;
    padding: 0.5rem;
  }

  .module-item {
    width: 90%;
    max-width: 400px;

    > h3 {
      text-align: left;
      margin-bottom: 0.5rem;
    }
  }

  .module-choice {
    display: block;
    text-decoration: none;
    color: white;
    background-color: green;
    padding: 1.3rem 1rem;
    border-radius: 5px;
    font-size: var(--button-font-size); 
    /* color: black;
    padding: 1.3rem 1rem;
    border: 4px solid #e7f079;
    border-radius: 5px;
    background-color: #e6f07924;
    font-size: var(--button-font-size); */
    text-align: center;
  }
</style>
