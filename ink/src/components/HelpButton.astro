---
const { helpPopup } = Astro.props;
---

<button id="help-button"> </button>

<style>
  #help-button {
    position: fixed;
    bottom: 0;
    right: 0;
    background: none;
    border: none;
    width: clamp(70px, 12vw, 120px);
    height: clamp(70px, 12vw, 120px);

    &:hover {
      cursor: pointer;
    }

    &::before {
      content: "";
      position: absolute;
      right: -15%;
      bottom: -20%;
      width: 100%;
      aspect-ratio: 1;
      border-radius: 50%;
      pointer-events: none;
      opacity: 0;
    }

    &.pulse::before {
      animation: helpPulse 2s infinite;
    }
  }

  @keyframes helpPulse {
    0% {
      opacity: 1;
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.8);
    }

    100% {
      opacity: 0;
      transform: scale(1.5);
      box-shadow: 0 0 0 25px rgba(255, 255, 255, 0);
    }
  }
</style>

<script is:inline>
  //@ts-nocheck

  document.addEventListener("click", (e) => {
    if (e.target?.id === "popupButton") {
      e.target.blur();
      window.popup.hide();
    }
  });

  function initHelpButton() {
    const button = document.getElementById("help-button");
    if (!button) return;

    // prevent duplicate listeners after Astro navigation
    button.replaceWith(button.cloneNode(true));
    const freshButton = document.getElementById("help-button");

    let inactivityTimer;

    function startInactivityTimer() {
      clearTimeout(inactivityTimer);

      freshButton.classList.remove("pulse");

      // only pulse if this page actually has help content
      if (!window.helpContext?.text) return;

      inactivityTimer = setTimeout(() => {
        freshButton.classList.add("pulse");
      }, 25000); // 25 seconds
    }

    function resetActivity() {
      startInactivityTimer();
    }

    freshButton.addEventListener("click", () => {
      console.log("Help button clicked");

      const help = window.helpContext;
      if (!help?.text) return;

      freshButton.classList.remove("pulse");

      window.popup.show({
        title: help.title || "Hier heb je een tip!",
        text: help.text,
        buttonText: "Sluiten",
      });

      startInactivityTimer();
    });

    ["mousemove", "mousedown", "keydown", "scroll", "touchstart"].forEach(
      (event) => {
        document.addEventListener(event, resetActivity, { passive: true });
      },
    );

    startInactivityTimer();
  }

  document.addEventListener("astro:page-load", initHelpButton);
  document.addEventListener("astro:after-swap", initHelpButton);
</script>
