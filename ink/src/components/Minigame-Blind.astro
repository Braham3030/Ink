---
---

<h2>Verwijs Tim naar de WC</h2>

<canvas id="game" width="400" height="400"></canvas>

<div class="buttons">
  <button onclick="runPath(1)">Voorbij de bar naar rechts</button>
  <button onclick="runPath(2)">Voorbij de bar naar rechts en dan links</button>
  <button onclick="runPath(3)">De wc's bevinden zich rechtsachter in de kamer</button>
  <button onclick="runPath(4)">De wc's zijn daar</button>
  <button class="reset" onclick="resetGame()">Reset</button>
</div>

<style>
/* body {
  background-color: #ffdb79;
  font-family: sans-serif;
} */

h2 {
  text-align: center;
  color: black;
}

canvas {
  display: block;
  margin: 20px auto;
  border: 2px solid black;
  background: white;
}

/* container */
.buttons {
  width: 400px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* base button */
button {
  width: 100%;
  padding: 12px;
  font-size: 14px;
  border: 2px solid black;
  background: white;
  cursor: pointer;
  transition: all 0.15s ease;
}

/* hover */
button:hover {
  background: black;
  color: white;
}

/* active click */
button:active {
  transform: scale(0.98);
}

/* reset knop speciaal */
.reset {
  background: #d2d2d2;
  border: 2px solid #000;
}
</style>

<script is:inline>
let canvas, ctx
const tileSize = 50

const startPosition = { x: 3, y: 7 }
const player = { x: 3, y: 7 }

const goal = { x: 6, y: 0, w: 2, h: 2, name: "WC" }

document.addEventListener("DOMContentLoaded", () => {
  canvas = document.getElementById("game")
  ctx = canvas.getContext("2d")

  render()
})

const obstacles = [
  { x: 1, y: 0, w: 2, h: 1, name: "Bank" },
  { x: 0, y: 1, w: 1, h: 2, name: "Bank" },
  { x: 2, y: 2, w: 1, h: 1, name: "Tafel" },
  { x: 2, y: 4, w: 1, h: 1, name: "Stoel" },
  { x: 2, y: 5, w: 1, h: 1, name: "Stoel" },
  { x: 1, y: 6, w: 1, h: 1, name: "Stoel" },
  { x: 0, y: 4, w: 1, h: 2, name: "TV" },
  { x: 5, y: 4, w: 1, h: 1, name: "Kruk" },
  { x: 5, y: 5, w: 1, h: 1, name: "Kruk" },
  { x: 5, y: 6, w: 1, h: 1, name: "Kruk" },
  { x: 5, y: 0, w: 1, h: 2, name: "Muur" },
  { x: 5, y: 3, w: 3, h: 1, name: "Muur" },
  { x: 6, y: 4, w: 1, h: 3, name: "Bar" }
]

function drawGrid() {
  ctx.clearRect(0, 0, canvas.width, canvas.height)

  ctx.strokeStyle = "#000"

  for (let x = 0; x <= 8; x++) {
    ctx.beginPath()
    ctx.moveTo(x * tileSize, 0)
    ctx.lineTo(x * tileSize, 400)
    ctx.stroke()
  }

  for (let y = 0; y <= 8; y++) {
    ctx.beginPath()
    ctx.moveTo(0, y * tileSize)
    ctx.lineTo(400, y * tileSize)
    ctx.stroke()
  }
}

function drawObstacles() {
  obstacles.forEach(o => {
    const x = o.x * tileSize
    const y = o.y * tileSize

    ctx.fillStyle = "#444"
    ctx.fillRect(x, y, o.w * tileSize, o.h * tileSize)

    ctx.strokeStyle = "#000"
    ctx.strokeRect(x, y, o.w * tileSize, o.h * tileSize)

    ctx.fillStyle = "white"
    ctx.fillText(o.name, x + 4, y + 16)
  })
}

function drawGoal() {
  ctx.fillStyle = "#2ecc71"
  ctx.fillRect(goal.x * tileSize, goal.y * tileSize, goal.w * tileSize, goal.h * tileSize)

  ctx.strokeStyle = "#000"
  ctx.strokeRect(goal.x * tileSize, goal.y * tileSize, goal.w * tileSize, goal.h * tileSize)

  ctx.fillStyle = "black"
  ctx.fillText("WC", goal.x * tileSize + 4, goal.y * tileSize + 16)
}

function drawPlayer() {
  ctx.fillStyle = "blue"

  ctx.fillRect(
    player.x * tileSize,
    player.y * tileSize,
    tileSize,
    tileSize
  )
}

function render() {
  drawGrid()
  drawObstacles()
  drawGoal()
  drawPlayer()
}

function moveTo(path, i = 0) {
  if (i >= path.length) return

  player.x = path[i].x
  player.y = path[i].y

  render()

  setTimeout(() => moveTo(path, i + 1), 300)
}

/* routes */
function runPath(type) {
  let path = []

  if (type === 1) {
    path = [
      { x: 3, y: 6 },
      { x: 3, y: 5 },
      { x: 3, y: 4 },
      { x: 3, y: 3 },
      { x: 3, y: 2 },
      { x: 4, y: 2 },
      { x: 5, y: 2 },
    ]
  }

  if (type === 2) {
    path = [
      { x: 3, y: 6 },
      { x: 3, y: 5 },
      { x: 3, y: 4 },
      { x: 3, y: 3 },
      { x: 3, y: 2 },
      { x: 4, y: 2 },
      { x: 5, y: 2 },
      { x: 6, y: 2 },
      { x: 6, y: 1 },
      { x: 6, y: 0 }
    ]
  }

  if (type === 3) {
    path = [
      { x: 3, y: 6 },
      { x: 3, y: 5 },
      { x: 3, y: 4 },
      { x: 3, y: 3 },
      { x: 3, y: 2 },
      { x: 3, y: 1 },
      { x: 3, y: 0 },
      { x: 4, y: 0 },
    ]
  }

  if (type === 4) {
    path = [
      { x: 3, y: 7 },
    ]
  }

  moveTo(path)
}

function resetGame() {
  player.x = startPosition.x
  player.y = startPosition.y
  render()
}
</script>