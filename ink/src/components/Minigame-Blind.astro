<h2>Minigame - Visuele beperking</h2>

<canvas id="game" width="400" height="400"></canvas>

<style>
body {
  background-color: #ffdb79;
  font-family: sans-serif;
}

h2 {
  text-align: center;
  color: black;
}

canvas {
  display: block;
  margin: 20px auto;
  border: 2px solid black;
  background: white;
}
</style>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const canvas = document.getElementById("game");
  const ctx = canvas.getContext("2d");

  const tileSize = 50;

  const player = { x: 3, y: 7 };

  const obstacles = [
    { x: 1, y: 0, w: 2, h: 1, name: "Bank" },
    { x: 0, y: 1, w: 1, h: 2, name: "Bank" },
    { x: 2, y: 2, w: 1, h: 1, name: "Tafel" },
    { x: 2, y: 4, w: 1, h: 1, name: "Stoel" },
    { x: 2, y: 5, w: 1, h: 1, name: "Stoel" },
    { x: 1, y: 6, w: 1, h: 1, name: "Stoel" },
    { x: 4, y: 0, w: 1, h: 2, name: "TV" },
    { x: 5, y: 4, w: 1, h: 1, name: "Kruk" },
    { x: 5, y: 5, w: 1, h: 1, name: "Kruk" },
    { x: 5, y: 6, w: 1, h: 1, name: "Kruk" },
    { x: 5, y: 0, w: 1, h: 2, name: "Muur" },
    { x: 5, y: 3, w: 3, h: 1, name: "Muur" },
    { x: 6, y: 4, w: 1, h: 3, name: "Bar" },
  ];

  const goal = { x: 6, y: 0, w: 2, h: 2, name: "WC" };

  function drawGrid() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    ctx.strokeStyle = "#000";

    for (let x = 0; x <= 8; x++) {
      ctx.beginPath();
      ctx.moveTo(x * tileSize, 0);
      ctx.lineTo(x * tileSize, 400);
      ctx.stroke();
    }

    for (let y = 0; y <= 8; y++) {
      ctx.beginPath();
      ctx.moveTo(0, y * tileSize);
      ctx.lineTo(400, y * tileSize);
      ctx.stroke();
    }
  }

  function drawObstacles() {
    obstacles.forEach(o => {
      const x = o.x * tileSize;
      const y = o.y * tileSize;
      const w = o.w * tileSize;
      const h = o.h * tileSize;

      ctx.fillStyle = "#444";
      ctx.fillRect(x, y, w, h);

      ctx.strokeStyle = "#000";
      ctx.lineWidth = 1;
      ctx.strokeRect(x, y, w, h);

      ctx.fillStyle = "white";
      ctx.font = "12px sans-serif";
      ctx.fillText(o.name, x + 4, y + 16);
    });
  }

  function drawGoal() {
    const x = goal.x * tileSize;
    const y = goal.y * tileSize;
    const w = goal.w * tileSize;
    const h = goal.h * tileSize;

    ctx.fillStyle = "#2ecc71";
    ctx.fillRect(x, y, w, h);

    ctx.strokeStyle = "#000";
    ctx.lineWidth = 1;
    ctx.strokeRect(x, y, w, h);

    ctx.fillStyle = "black";
    ctx.font = "12px sans-serif";
    ctx.fillText(goal.name, x + 4, y + 16);
  }

  function drawPlayer() {
    ctx.fillStyle = "blue";

    ctx.fillRect(
      player.x * tileSize,
      player.y * tileSize,
      tileSize,
      tileSize
    );
  }

  function render() {
    drawGrid();
    drawObstacles();
    drawGoal();
    drawPlayer();
  }

  render();
});
</script>