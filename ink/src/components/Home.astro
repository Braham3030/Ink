<div>
  <h1 transition:name="title-text">Start de module</h1>
  <a href="/modules" class="start-button" transition:name="module-window">
    Start
  </a>
</div>

<style>
  div {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 20vh;
    /* height: 100%; */
    > h1 {
      /* margin: 0 auto; */
      color: black;
      width: fit-content;
    }

    > .start-button {
      display: block;
      margin: 2rem auto;
      padding: 0.8em 2.3em;

      background-color: green;
      color: white;
      border: none;
      border-radius: 0.5rem;

      font-size: 2rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;

      transition:
        background-color 0.2s ease,
        transform 0.2s ease;
    }

    .start-button:hover {
      background-color: darkgreen;
      transform: scale(1.05);
    }
  }
</style>
