---
import Popup from "../components/Popup.astro";
---

<div>
  <h1 transition:name="title-text">Start de training</h1>
  <a href="/modules" class="link-button" transition:name="module-window">
    Start
  </a>
</div>

<Popup />

<style>
  div {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 25vh;
    /* height: 100%; */
    > h1 {
      /* margin: 0 auto; */
      color: black;
      width: fit-content;

      opacity: 0;
      transform: translateY(10px);

      animation: comeIntitle 0.6s cubic-bezier(0.25, 1.5, 0.5, 1) forwards;
    }

    > .link-button {
      transition:
        background-color 0.2s ease,
        transform 0.2s ease;
    }

    .link-button:hover {
      transform: scale(1.05);
    }

    #help-button {
      aria-hidden: true;
    }
  }

  @keyframes comeIntitle {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  //@ts-nocheck
  window.helpContext = {
    title: "Dit kunt u altijd vragen!",
    text: "U kan aan iemand met een beperking altijd vragen: 'Heeft u hulp nodig?' of 'Hoe kan ik u het beste helpen?'",
  };
</script>