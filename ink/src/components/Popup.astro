---
const {
  title = "Popup",
  text = "",
  buttonText = "Volgende",
  endScreenLink = "",
} = Astro.props;
// const { title = "Popup", text = "", buttonText = "Volgende" } = Astro.props;
---

<div class="popup-overlay" id="popupOverlay" aria-hidden="true" hidden>
  <div class="popup">
    <h2>{title}</h2>
    <p>{text}</p>
    <button id="popupButton">{buttonText}</button>
    <a href={endScreenLink} class="nextScreen">{buttonText}</a>
  </div>
</div>

<style>
  .popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);

    display: flex;
    align-items: center;
    justify-content: center;

    z-index: 9999;

    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .popup-overlay.show {
    opacity: 1;
    pointer-events: auto;
  }

  .popup {
    background: white;
    padding: 1.5rem;
    margin: 0.8rem;
    border: 2px solid black;
    width: 300px;
    text-align: center;

    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .popup h2 {
    margin: 0 0 10px;
  }

  .popup p {
    margin: 0 0 20px;
  }

  .nextScreen {
    display: none;
    width: 100%;
    padding: 10px;
    border: 2px solid black;
    background: white;
    color: black;
    cursor: pointer;
    text-decoration: none;
    box-sizing: border-box;
  }

  .nextScreen:hover {
    background: black;
    color: white;
  }

  .popup button {
    display: block;
    width: 100%;
    padding: 10px;
    border: 2px solid black;
    background: white;
    cursor: pointer;
  }

  .popup button:hover {
    background: black;
    color: white;
  }

  .nextScreen {
    display: none;
  }
</style>

<script is:inline>
  // @ts-nocheck
  function getOverlay() {
    return document.getElementById("popupOverlay");
  }

  function showPopup({ title, text, buttonText, endScreenLink }) {
    const overlay = getOverlay();

    if (!overlay) {
      console.warn("Popup overlay not found");
      return;
    }

    const h2 = overlay.querySelector("h2");
    const p = overlay.querySelector("p");
    const btn = overlay.querySelector("button");

    if (h2) h2.textContent = title;
    if (p) p.textContent = text;
    if (btn) btn.textContent = buttonText;

    overlay.classList.add("show");
    overlay.setAttribute("aria-hidden", "false");
  }

  function hidePopup() {
    const overlay = getOverlay();
    if (!overlay) return;

    overlay.classList.remove("show");
    overlay.setAttribute("aria-hidden", "true");
  }

  window.popup = {
    show: showPopup,
    hide: hidePopup,
  };
</script>
