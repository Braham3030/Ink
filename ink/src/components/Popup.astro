---
const {
  title = "Popup",
  text = "",
  buttonText = "Volgende",
  endScreenLink = "",
} = Astro.props;
---

<div class="popup-overlay" id="popupOverlay" aria-hidden="true" hidden>
  <div class="popup">
    <h2>{title}</h2>
    <p>{text}</p>

    {
      endScreenLink ? (
        <a class="popup-button" href={endScreenLink}>
          {buttonText}
        </a>
      ) : (
        <button id="popupButton">{buttonText}</button>
      )
    }
  </div>
</div>

<style>
  .popup-overlay {
    position: fixed;
    inset: 0;

    background: rgba(10, 14, 20, 0.65);
    backdrop-filter: blur(4px);

    display: flex;
    align-items: center;
    justify-content: center;

    z-index: 9999;

    opacity: 0;
    pointer-events: none;

    transition: opacity 0.15s ease;
  }

  .popup-overlay.show {
    opacity: 1;
    pointer-events: auto;
  }

  .popup {
    width: min(90%, 360px);
    margin: 0.8rem;
    background: #ffffff;
    border: 2px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.5rem;

    h2 {
      text-align: center;
    }
   

    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.25),
      0 8px 20px rgba(0, 0, 0, 0.15);

    /* start state */
    opacity: 0;
    transform: translateY(10px) scale(0.98);
  }

  .popup-overlay.show .popup {
    animation: popupIn 0.2s ease-out forwards;
  }

  .popup h2 {
    margin: 0 0 0.75rem;
    font-size: 1.4rem;
    font-weight: 700;
    color: #0f172a;
  }

  .popup p {
    margin: 0 0 1.25rem;
    font-size: 1.1rem;
    line-height: 1.5;
    color: #475569;
  }

  .popup button,
  .popup-button {
    width: 100%;
    display: inline-block;

    padding: 0.9rem;

    border: none;
    border-radius: 10px;

    background: #0f172a;
    color: white;

    font-weight: 600;
    text-decoration: none;
    cursor: pointer;

    transition:
      transform 0.28s ease,
      background 0.12s ease;
  }

  .popup button:hover,
  .popup-button:hover {
    background: #1e293b;
    transform: translateY(-1px);
  }

  .popup button:active,
  .popup-button:active {
    transform: translateY(1px);
  }

  @keyframes popupIn {
    0% {
      opacity: 0;
      transform: translateY(20px) scale(0.92);
    }

    50% {
      opacity: 1;
      transform: translateY(-6px) scale(1.03);
    }

    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script is:inline>
  // @ts-nocheck

  function getOverlay() {
    return document.getElementById("popupOverlay");
  }

  function showPopup({ title, text, buttonText }) {
    const overlay = getOverlay();
    if (!overlay) return;

    const h2 = overlay.querySelector("h2");
    const p = overlay.querySelector("p");
    const btn = overlay.querySelector("button");

    window.isPopupOpen = true;

    if (h2) h2.textContent = title;
    if (p) p.textContent = text;
    if (btn) btn.textContent = buttonText;

    overlay.hidden = false;
    overlay.classList.add("show");
    overlay.setAttribute("aria-hidden", "false");
  }

  function hidePopup() {
    const overlay = getOverlay();
    if (!overlay) return;

    overlay.classList.remove("show");
    overlay.setAttribute("aria-hidden", "true");

    window.isPopupOpen = false;

    setTimeout(() => {
      overlay.hidden = true;
    }, 150);
  }

  window.isPopupOpen = false;

  window.popup = {
    show: showPopup,
    hide: hidePopup,
  };
</script>
