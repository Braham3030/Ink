---
const {
  title = "Popup",
  text = "",
  buttonText = "Volgende"
} = Astro.props
---

<div class="popup-overlay hidden" id="popupOverlay">
  <div class="popup" id="popupBox">
    <h2>{title}</h2>
    <p>{text}</p>

    <div class="buttons">
      <button class="primary" id="popupButton">
        {buttonText}
      </button>
    </div>
  </div>
</div>

<style>
.popup-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.hidden {
  display: none;
}

.popup {
  background: white;
  border: 3px solid black;
  border-radius: 18px;

  width: min(420px, 90vw);
  min-height: 320px;

  padding: 24px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  text-align: center;
}

@media (max-width: 500px) {
  .popup {
    width: 92vw;
    min-height: 380px;
  }
}

.popup h2 {
  margin: 0;
  font-size: 28px;
}

.popup p {
  margin: 12px 0 0;
  font-size: 16px;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.buttons {
  display: flex;
}

button {
  flex: 1;
  padding: 12px;
  border: 2px solid black;
  background: white;
  cursor: pointer;
}

button:hover {
  background: black;
  color: white;
}

.primary {
  background: #848484;
}
</style>

<script is:inline>
function openPopup() {
  const overlay = document.getElementById("popupOverlay")
  overlay?.classList.remove("hidden")
}

function closePopup() {
  const overlay = document.getElementById("popupOverlay")
  overlay?.classList.add("hidden")
}

document.addEventListener("DOMContentLoaded", () => {
  const overlay = document.getElementById("popupOverlay")
  const box = document.getElementById("popupBox")
  const button = document.getElementById("popupButton")

  if (!overlay) return

  // klik buiten popup sluit
  overlay.addEventListener("click", closePopup)

  // klik binnen popup niet sluiten
  box.addEventListener("click", (e) => e.stopPropagation())

  // knop sluit popup
  button?.addEventListener("click", closePopup)
})
</script>