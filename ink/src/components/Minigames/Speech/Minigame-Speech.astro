---
import './speech.css'
import { speechData } from '../../../data/speechData.js'
import Popup from "../../Popup.astro";
import { Image } from "astro:assets";
import SpeakerImage from "../../../assets/images/disabilities/speech.jpg"
---

<div class="content" transition:name="avatar-Evelin">
  <h2 transition:name="title-text">Praat met Evelin</h2>



  <div id="dialogue" class="dialogue hidden">
    <Image id="speaker-image" class="speaker-image" src={SpeakerImage} alt="Spekaer Image"/>
    <div id="dialogue-box" class="dialogue-box" transition:name="text-Evelin">
        <p id="speaker-name" class="speaker-name"></p>
        <p id="dialogue-text" class="dialogue-text"></p>
    </div>
  </div>

  <div id="checklist" class="checklist hidden">
    <h3>Voortgang</h3>
    <ul id="checklist-items"></ul>
  </div>

  <div id="start-container" transition:name="button-Evelin">
    <button id="start-button">Start</button>
  </div>
  <div id="interrupt-container">
    <button id="interrupt-button" class="hidden">Help zin afmaken</button>
  </div>
</div>

<Popup
  title="Goed gedaan!"
  text="Gesprek is beëindigd."
  buttonText="Volgende"
/>

<script is:inline define:vars={{ speechData }}>
    // @ts-nocheck
  window.speechData = speechData;
</script>

<script src="./speech.js"></script>
