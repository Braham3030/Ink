---
import './speech.css'
import { speechData } from '../../../data/speechData.js'
import Popup from "../../Popup.astro";
---

<div class="content" transition:name="avatar-Evelin">
  <h2 transition:name="title-text">Praat met Evelin</h2>



  <div id="dialogue" class="dialogue hidden">
    <img id="speaker-image" class="speaker-image" src="../../../../src/assets/images/disabilities/speech.jpg" alt="Speaker Image">
    <div id="dialogue-box" class="dialogue-box">
        <p id="speaker-name" class="speaker-name"></p>
        <p id="dialogue-text" class="dialogue-text"></p>
    </div>
  </div>

  <div id="start-container">
    <button id="start-button">Start</button>
  </div>
  <div id="interrupt-container">
    <button id="interrupt-button" class="hidden" transition:name="button-Evelin">Start Praten</button>
  </div>
</div>

<Popup
  title="Goed gedaan!"
  text="Gesprek is beëindigd."
  buttonText="Volgende"
/>

<script is:inline define:vars={{ speechData }}>
    // @ts-nocheck
  window.speechData = speechData;
</script>

<script src="./speech.js"></script>
