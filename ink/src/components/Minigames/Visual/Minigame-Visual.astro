---
import Popup from "../../Popup.astro";
import { Image } from "astro:assets";
import looksDisability from "../../../assets/images/disabilities/looks.jpg";
---


<div class="screen">
  <h2 transition:name="title-text">Praat met Eduard</h2>

  <div class="dialogue">
    <Image
      src={looksDisability}
      alt="afbeelding van Eduard"
      class="speaker-image"
      transition:name="avatar-Eduard"
    />
    <div class="dialogue-box" transition:name="text-Eduard">
      <p class="speaker-name">Eduard</p>
      <p class="dialogue-text"></p>
    </div>
  </div>

  <div class="choices" transition:name="button-Eduard"></div>
</div>

<Popup />


<style>
  .screen {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 500px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
  }

  h2 {
    margin-bottom: 1rem;
  }

  .chat-area {
    margin-top: 4rem;
    position: relative;
  }

  /* .avatar {
    position: absolute;
    top: -77px;
    right: -9px;
    width: 100px;
    height: 110px;
    object-fit: cover;
    border-radius: 50%;
    z-index: 0;
  } */

  /* .speech-bubble {
  position: relative;
  z-index: 1;
  margin-right: 3rem;

  background: linear-gradient(180deg, #ffffff 0%, #f6f7ff 100%);
  border: 2px solid rgba(0, 0, 0, 0.6);
  border-radius: 14px;

  padding: 0.9rem 1rem;

  box-shadow: 0 3px 0 rgba(70, 80, 180, 0.12);
} */

  /* .bubble-name {
    font-size: 1.2rem;
    color: black;
    margin: 0 0 4px;
  }

  .bubble-text {
    margin: 0;
    line-height: 1.5;
  } */

  .choices {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  button {
    text-align: left;
    padding: 0.75rem 1rem;
    border: 2px solid #000000;
    border-radius: 6px;
    background: hsl(200 80% 80%);

    background: linear-gradient(180deg, #ffffff 0%, #f4f5ff 100%);
    border: 2px solid rgba(70, 80, 180, 0.5);
    border-radius: 14px;

    padding: 0.9rem 1rem 0.9rem 1rem;
    text-align: left;

    color: #1a1a1a;

    box-shadow: 0 3px 0 rgba(70, 80, 180, 0.15);

    transition:
      transform 0.08s ease,
      box-shadow 0.08s ease,
      background 0.08s ease;

      cursor: pointer;
  }

  @media (min-width: 768px) {
    .screen {
      max-width: 480px;
    }

    h2 {
      font-size: 2rem;
    }

    .bubble-name {
      font-size: 1.4rem;
    }

    .bubble-text {
      font-size: 1.1rem;
    }

    button {
      font-size: 1.1rem;
    }

