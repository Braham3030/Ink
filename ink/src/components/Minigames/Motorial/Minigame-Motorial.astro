---
import "./motorial.css";
import Popup from "../../Popup.astro";
import { levels } from "../../../data/motorialData";
---

<div class="content">
  <h2 transition:name="title-text">Ga het gebouw in</h2>
  <p transition:name="text-Anna">Klik op de onderdelen die voor Anna een obstakel zouden kunnen zijn.</p>

  <div class="image-wrapper">
    <img id="level-image" src={levels[0].image} />
  </div>

  <h2>Gevonden obstakels</h2>
  <ul id="found-list"></ul>

  <button id="done-button" class="link-button" transition:name="button-Anna"> Klaar! </button>
</div>

<Popup
  title="Goed gedaan!"
  text="Je hebt alle obstakels gevonden."
  buttonText="Volgende"
/>

<script>
  import "./motorial.js";
</script>