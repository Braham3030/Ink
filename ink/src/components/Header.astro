---
// With the following line, it is possible to obtain the url information of the page.
// https://docs.astro.build/en/reference/api-reference/
const isHome =  Astro.url.pathname === "/";
---

<header>
    {!isHome &&
    <a id="back-button" href="javascript:history.back()">
        ←
    </a>
    }
</header>

<!-- <script>
    // Back button functionality using the history of the browser.
    // https://developer.mozilla.org/en-US/docs/Web/API/History/back
    document.getElementById("Back-Button").addEventListener("click", () => {
  history.back();
});
</script> -->

<style>
    header {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        background-color: transparent;

        position: fixed;
        top: 0;
        left: 0;
        transform: translateY(0);
        width: 100%;
        height: 6rem;
        z-index: 999;
        pointer-events: none;

        > #back-button {
            /* position: absolute;
            left: 16px;
            transform: translateX(0); */
            padding: 0;
            margin-left: 1.5rem;
            background-color: transparent;
            color: black;
            border-radius: 50%;
            font-size: 3rem;
            pointer-events: auto;
            cursor: pointer;
            text-decoration: none;
            width: 4rem;
            height: 4rem;

            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1;

            backdrop-filter: blur(0px);
            box-shadow: 0 0 10px rgba(0, 0, 0, 0);
            filter: brightness(0);
            transform: scale(0.5);
            opacity: 0;
            /* opacity: 1; */

            animation: popIn 0.4s cubic-bezier(0.25, 1.5, 0.5, 1) forwards 0.2s;
        }
    }

    @keyframes popIn {
        0% {
            backdrop-filter: blur(0px);
            box-shadow: 0 0 10px rgba(0, 0, 0, 0);
            filter: brightness(0);
            transform: scale(0.1);
            opacity: 0;
        }
        100% {
            backdrop-filter: blur(4px);
            box-shadow: 0 0 10px rgba(0, 0, 0, 1);
            filter: brightness(2.15);
            transform: scale(1);
            opacity: 1;
        }
    }
</style>