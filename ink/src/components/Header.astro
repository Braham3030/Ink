---
// With the following line, it is possible to obtain the url information of the page.
// https://docs.astro.build/en/reference/api-reference/
const isHome = Astro.url.pathname === "/";
---

<header transition:name="header">
  {
    !isHome && (
      <a id="back-button" href="javascript:history.back()">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
          <path
            d="M4 12H20M4 12L8 8M4 12L8 16"
            stroke="#000000"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    )
  }
</header>

<!-- <script>
    // Back button functionality using the history of the browser.
    // https://developer.mozilla.org/en-US/docs/Web/API/History/back
    document.getElementById("Back-Button").addEventListener("click", () => {
  history.back();
});
</script> -->

<style>
  header {
    display: flex;
    align-items: center;
    background-color: transparent;

    position: fixed;
    top: 0;
    left: 0;
    transform: translateY(0);
    width: 100%;
    z-index: 2;
    pointer-events: none;

    > #back-button {
      /* position: absolute;
            left: 16px;
            transform: translateX(0); */
      padding: 0;
      background-color: rgba(255, 255, 255, 0.543);
      color: black;
      border-radius: 50%;
      font-size: 2.8rem;
      pointer-events: auto;
      cursor: pointer;
      text-decoration: none;
      margin: 0.5rem;

      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;

      backdrop-filter: blur(0px);
      box-shadow: 0 0 10px rgba(0, 0, 0, 0);
      filter: brightness(0);
      transform: scale(0.5);
      /* opacity: 1; */

      animation: popIn 0.4s cubic-bezier(0.25, 1.5, 0.5, 1) forwards 0.2s;
    }
  }

  #back-button svg {
    width: 2.7rem;
    height: 2.7rem;

    @media (min-width: 768px) {
      width: 3.5rem;
      height: 3.5rem;
    }
  }

  @keyframes popIn {
    0% {
      backdrop-filter: blur(0px);
      box-shadow: 0 0 0px rgba(0, 0, 0, 0);
      filter: brightness(0);
      transform: scale(0.1);
      opacity: 0;
    }
    100% {
      backdrop-filter: blur(12px);
      filter: brightness(2.15);
      transform: scale(1);
    }
  }
</style>
