---
//@ts-nocheck
/*
    Gebruik deze component om een persona te introduceren.
    Voorbeeld:
    <PersonIntro 
        name="Tim"
        image="/images/disabilites/visual.jpg"
        description="Tim is blind en..."
    />
*/
import { Image } from "astro:assets";
const { name, description, image, link } = Astro.props;
---

<div class="card">
  <h2>Dit is {name}</h2>

  <div class="avatar">
    <Image src={image} alt={`afbeelding van ${name}`} />
  </div>

  <p>{description}</p>

  <a href={link}>Begin</a>
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem 1.5rem;
    max-width: 600px;
    margin: 0 auto;
  }

  p {
    text-align: center;
    line-height: 1.6;
    opacity: 0;
    transform: translateY(-40px) scale(0.75);

    animation: slideInText 0.6s cubic-bezier(0.25, 1.5, 0.5, 1) 0.6s both;
  }

  @keyframes slideInText {
    0% {
      transform: translateY(-40px) scale(0.75);
      opacity: 0;
    }
    100% {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  a {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;

    width: fit-content;
    width: clamp(150px, 121.4286px + 8.9286vw, 250px);
    padding: 0.85rem;
    border-radius: 7px;
    border: none;
    cursor: pointer;
    background: #111827;
    color: white;
    transition: 0.2s ease;
    font-size: var(--button-font-size);
    /* width: 80%;
    max-width: 250px;
    padding: 0.85rem;
    border: 2px solid rgb(0, 0, 0);
    border-radius: 3px;
    background-color: rgb(255, 255, 255);
    color: black;
    cursor: pointer;
    font-size: var(--button-font-size); */
  }

  img {
    display: block;
    width: 75%;
    height: auto;
    margin: 0 auto;
    opacity: 0;
    transform: scale(0.2);
    border-radius: 18px;

    animation: zoomIn 1.2s cubic-bezier(0.25, 1.5, 0.5, 1) both;
  }

  @keyframes zoomIn {
    0% {
      border-radius: 16px;
      transform: scale(0.2);
      opacity: 0;
    }
    100% {
      border-radius: 5px;
      transform: scale(1);
      opacity: 1;
    }
  }
</style>
