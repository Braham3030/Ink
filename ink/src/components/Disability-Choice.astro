---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import visualDisability from "../assets/images/disabilities/visual.jpg";
import auditoryDisability from "../assets/images/disabilities/auditory.jpg";
import motorialDisability from "../assets/images/disabilities/motor.jpg";
import looksDisability from "../assets/images/disabilities/looks.jpg";
import speechDisability from "../assets/images/disabilities/speech.jpg";
import Popup from "../components/Popup.astro";
---

<!-- Braham: usage of "Image" tag to reduce stutter and lag --><!-- https://docs.astro.build/en/guides/images/ -->
<h2 transition:name="title-text">Kies een onderdeel</h2>

<div class="choice-grid" data-astro-prefetch="viewport">
  <a
    href="/blind-introduction"
    class="choice"
    transition:name="blind-introduction-window"
  >
    <Image
      src={visualDisability}
      alt="Visueel beperkt persoon"
      loading="eager"
      fetchpriority="high"
      transition:name="avatar-Tim"
    />
    <h3>Visuele beperking</h3>
  </a>

  <a
    href="/deaf-introduction"
    class="choice"
    transition:name="deaf-introduction-window"
  >
    <Image
      src={auditoryDisability}
      alt="Auditief beperkt persoon"
      loading="eager"
      fetchpriority="high"
      transition:name="avatar-Nick"
    />
    <h3>Auditieve beperking</h3>
  </a>

  <a
    href="/motorial-introduction"
    class="choice"
    transition:name="motorial-introduction-window"
  >
    <Image
      src={motorialDisability}
      alt="Motorisch beperkt persoon"
      transition:name="avatar-Anna"
    />
    <h3>Motorische beperking</h3>
  </a>

  <a
    href="/visual-introduction"
    class="choice"
    transition:name="visual-introduction-window"
  >
    <Image
      src={looksDisability}
      alt="Opvallend uiterlijk persoon"
      transition:name="avatar-Eduard"
    />
    <h3>Opvallend uiterlijk</h3>
  </a>

  <a
    href="/speech-introduction"
    class="choice"
    transition:name="speech-introduction-window"
  >
    <Image
      src={speechDisability}
      alt="Spraakgebrek persoon"
      transition:name="avatar-Evelin"
    />
    <h3>Spraakgebrek</h3>
  </a>
</div>

<Popup />

<script>
  // @ts-nocheck

  window.helpContext = {
    title: "Ontspan",
    text: "U hoeft niet te schrikken of onmiddelijk te hulp te schieten wanneer iemand met een beperking binnenkomt. Zij zijn gewoon hun leven aan het leiden. Bied rustig en respectvol hulp aan.",
  };

  // Transition name will be given upon page load. This script will contain the current animation, so the animation to the next screen will occur more precise
  document.addEventListener("astro:page-load", () => {
    const choices = document.querySelectorAll(".choice");

    choices.forEach((choice) => {
      const transitionName = choice.getAttribute("data-transition-name");

      if (transitionName) {
        blindChoice.style.viewTransitionName = "none";

        blindChoice.addEventListener("click", () => {
          blindChoice.style.viewTransitionName = transitionName;

          setTimeout(() => {}, 300);
        });
      }
    });
  });
</script>

<style>
  body {
    overflow-x: hidden;
  }

  h3 {
    opacity: 0;
    transform: translateY(-40px) scale(0.75);
    text-align: center;
    background-color: white;
    box-shadow: 0 -3px 0px rgba(231, 240, 121, 0);
    padding: 1em;
    width: 100%;
    margin: 0;

    transition:
      background-color 0.6s cubic-bezier(0.25, 1.5, 0.5, 1) 1s,
      box-shadow 0.4s cubic-bezier(0.25, 1.5, 0.5, 1),
      scale 0.6s cubic-bezier(0.25, 1.5, 0.5, 1);
    animation: slideIn 0.6s cubic-bezier(0.25, 1.5, 0.5, 1) 0.6s forwards;
  }

  @keyframes slideIn {
    0% {
      transform: translateY(-40px) scale(0.75);
      opacity: 0;
    }
    100% {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    /* border: 3px solid; */
    border-radius: 16px;
    transform: scale(0.2);

    transition: all 0.6s cubic-bezier(0.25, 1.5, 0.5, 1);

    animation: zoomInFrame 1.2s cubic-bezier(0.25, 1.5, 0.5, 1) forwards;

    &:hover {
      cursor: pointer;
      scale: 1.05;
      /* box-shadow: 0 8px 50px rgba(0, 0, 0, 0.6); */
    }
  }

  @keyframes zoomInFrame {
    0% {
      border-radius: 16px;
      transform: scale(0.2);
      opacity: 0;
    }
    100% {
      border-radius: 0px;
      transform: scale(1);
      opacity: 1;
    }
  }

  .choice-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2em;
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
    justify-items: center;

    @media (min-width: 380px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (min-width: 1024px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .choice {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: black;
    /* background-color: rgba(255, 255, 255, 0.6); */
    backdrop-filter: blur(8px);
    border-radius: 5px;
    width: 80%;
    /* padding: 0.1em; */
    overflow: hidden;

    &:nth-child(1) {
      background-color: rgba(231, 240, 121, 0.6);
      border: 4px solid #e7f079;

      &:hover {
        box-shadow: 0 0px 20px rgba(231, 240, 121, 1);
      }
    }
    &:nth-child(2) {
      background-color: rgba(43, 182, 135, 0.6);
      border: 4px solid #2bb687;

      &:hover {
        box-shadow: 0 0px 20px rgba(43, 182, 135, 1);
      }
    }
    &:nth-child(3) {
      background-color: rgba(113, 148, 255, 0.6);
      border: 4px solid #7194ff;

      &:hover {
        box-shadow: 0 0px 20px rgba(113, 148, 255, 1);
      }
    }
    &:nth-child(4) {
      background-color: rgba(255, 147, 223, 0.6);
      border: 4px solid #ff93df;

      &:hover {
        box-shadow: 0 0px 20px rgba(255, 147, 223, 1);
      }
    }
    &:nth-child(5) {
      background-color: rgba(255, 102, 49, 0.6);
      border: 4px solid #ff6631;

      &:hover {
        box-shadow: 0 0px 20px rgba(255, 102, 49, 1);
      }
    }
  }

  :has(.choice:first-of-type:hover) .choice:first-of-type > h3 {
    scale: 1.05;
    box-shadow: 0 -5px 10px rgba(231, 240, 121, 0.6);
  }

  :has(.choice:nth-of-type(2):hover) .choice:nth-of-type(2) > h3 {
    scale: 1.05;
    box-shadow: 0 -5px 10px rgba(43, 182, 135, 0.6);
  }

  :has(.choice:nth-of-type(3):hover) .choice:nth-of-type(3) > h3 {
    scale: 1.05;
    box-shadow: 0 -5px 10px rgba(113, 148, 255, 0.6);
  }

  :has(.choice:nth-of-type(4):hover) .choice:nth-of-type(4) > h3 {
    scale: 1.05;
    box-shadow: 0 -5px 10px rgba(255, 147, 223, 0.6);
  }

  :has(.choice:nth-of-type(5):hover) .choice:nth-of-type(5) > h3 {
    scale: 1.05;
    box-shadow: 0 -5px 10px rgba(255, 102, 49, 0.6);
  }
</style>
